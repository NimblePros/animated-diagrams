{
  "name": "animated-diagrams",
  "version": "0.2.0",
  "private": true,
  "description": "Declarative, step-by-step animated box-and-arrow SVG diagrams with captions, for web pages, blogs and Slidev decks.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NimblePros/animated-diagrams.git"
  },
  "files": [
    "src",
    "vue",
    "fonts"
  ],
  "exports": {
    ".": "./src/index.js",
    "./model": "./src/diagram-model.js",
    "./renderer": "./src/diagram-renderer.js",
    "./animator": "./src/diagram-animator.js",
    "./player": "./src/player.js",
    "./autoload": "./src/autoload.js",
    "./diagram.css": "./src/diagram.css",
    "./page.css": "./src/page.css",
    "./fonts.css": "./fonts/fonts.css",
    "./vue": "./vue/AnimatedDiagram.vue",
    "./slidev": "./vue/SlidevAnimatedDiagram.vue"
  },
  "sideEffects": [
    "./src/autoload.js",
    "*.css",
    "*.vue"
  ],
  "keywords": [
    "diagram",
    "animation",
    "svg",
    "animejs",
    "slidev"
  ],
  "scripts": {
    "start": "npx --yes serve .",
    "test": "npm run test:model && npm run test:browser",
    "test:model": "node --test \"test/model/*.test.js\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  },
  "peerDependencies": {
    "@slidev/client": ">=0.48.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@slidev/client": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  }
}
